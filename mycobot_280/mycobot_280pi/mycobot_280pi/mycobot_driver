import rclpy
from rclpy.node import Node
from sensor_msgs.msg import JointState
from std_msgs.msg import Header
from visualization_msgs.msg import Marker
import math
import pymycobot
from packaging import version

# Minimum pymycobot version required
MIN_REQUIRE_VERSION = '3.6.1'

current_version = pymycobot.__version__
print('Current pymycobot library version: {}'.format(current_version))
if version.parse(current_version) < version.parse(MIN_REQUIRE_VERSION):
    raise RuntimeError('The version of pymycobot must be >= {}. Current version: {}'.format(MIN_REQUIRE_VERSION, current_version))
else:
    print('pymycobot version is valid!')
    from pymycobot import MyCobot280

class MyCobotDriver(Node):
    def __init__(self):
        super().__init__("mycobot_driver")

        # Declare ROS parameters for serial port and baudrate
        self.declare_parameter('port', '/dev/ttyAMA0')
        self.declare_parameter('baud', 1000000)

        port = self.get_parameter("port").get_parameter_value().string_value
        baud = self.get_parameter("baud").get_parameter_value().integer_value
        self.get_logger().info("Connecting to myCobot on port: %s at baudrate: %d" % (port, baud))

        # Initialize myCobot hardware driver
        self.mc = MyCobot280(port, str(baud))
        self.mc.release_all_servos()

        # Publisher for joint states
        self.joint_pub = self.create_publisher(JointState, "joint_states", 10)

        # Publisher for visualization marker
        self.marker_pub = self.create_publisher(Marker, "visualization_marker", 10)

        # Subscriber to receive joint targets
        self.target_sub = self.create_subscription(
            JointState,
            "target_joint_states",
            self.target_callback,  # Handle incoming target joint positions
            10
        )

        # Timer to regularly publish joint states and marker
        self.timer = self.create_timer(1.0 / 30.0, self.timer_callback)  # 30 Hz

        # Prepare reusable JointState message
        self.joint_state_msg = JointState()
        self.joint_state_msg.name = [
            "joint2_to_joint1",
            "joint3_to_joint2",
            "joint4_to_joint3",
            "joint5_to_joint4",
            "joint6_to_joint5",
            "joint6output_to_joint6",
        ]
        self.joint_state_msg.velocity = [0.0]
        self.joint_state_msg.effort = []

        # Prepare reusable Marker message
        self.marker_msg = Marker()
        self.marker_msg.header.frame_id = "/joint1"
        self.marker_msg.ns = "my_namespace"
        self.marker_msg.type = Marker.SPHERE
        self.marker_msg.action = Marker.ADD
        self.marker_msg.scale.x = 0.04
        self.marker_msg.scale.y = 0.04
        self.marker_msg.scale.z = 0.04
        self.marker_msg.color.a = 1.0
        self.marker_msg.color.g = 1.0  # green

    def timer_callback(self):
        # Periodically read and publish joint positions and marker
        try:
            # Read joint angles in radians
            angles = self.mc.get_radians()
            self.get_logger().info('Current angles: {}'.format([round(math.degrees(a), 2) for a in angles]))

            self.joint_state_msg.header = Header()
            self.joint_state_msg.header.stamp = self.get_clock().now().to_msg()
            self.joint_state_msg.position = angles
            self.joint_pub.publish(self.joint_state_msg)

            # Read end-effector coordinates
            coords = self.mc.get_coords()
            if not coords:
                coords = [0, 0, 0, 0, 0, 0]

            # Update marker pose
            self.marker_msg.header.stamp = self.get_clock().now().to_msg()
            self.marker_msg.pose.position.x = coords[1] / 1000 * -1  # x and y swapped
            self.marker_msg.pose.position.y = coords[0] / 1000
            self.marker_msg.pose.position.z = coords[2] / 1000
            self.marker_pub.publish(self.marker_msg)

        except Exception as e:
            self.get_logger().error(f"Error reading from myCobot: {e}")

    def target_callback(self, msg):
        # Callback to apply new target joint positions
        try:
            if len(msg.position) != 6:
                self.get_logger().warn("Received target joint state with invalid length.")
                return
            self.get_logger().info("Applying target joint angles (deg): {}".format(
                [round(math.degrees(a), 2) for a in msg.position]))
            self.mc.send_radians(msg.position, 80)
        except Exception as e:
            self.get_logger().error(f"Failed to send joint commands: {e}")


def main(args=None):
    rclpy.init(args=args)
    node = MyCobotDriver()
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()

if __name__ == "__main__":
    main()
